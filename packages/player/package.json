{
  "name": "@choreobit/player",
  "version": "0.0.0",
  "private": true,
  "description": "ChoreoBit: a browser playback controller for a core Scene on a Canvas 2D surface.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luddchad/choreobit.git",
    "directory": "packages/player"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@choreobit/core": "workspace:*",
    "@choreobit/primitives": "workspace:*",
    "@choreobit/animation": "workspace:*",
    "@choreobit/renderer": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
